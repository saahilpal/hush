{
  "manifest_version": 3,
  "name": "Hush for Gmail",
  "version": "1.2.0",
  "description": "Private email open tracker for Gmail with zero watermarks and self-open protection",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Hush Options",
    "default_popup": "options.html"
  }
}
